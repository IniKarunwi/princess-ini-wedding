{
  "name": "princess-ini-wedding",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.api.json",
    "seating:migration": "node scripts/seating/make-migration.mjs",
    "seating:hash-pin": "node scripts/seating/hash-pin.mjs",
    "test:planner": "node scripts/seating/planner-test.mjs",
    "sync:rsvps": "node --env-file-if-exists=.env scripts/sync/run.mjs",
    "build:appsscript": "node scripts/sync/build-appsscript.mjs",
    "test:appsscript": "node scripts/sync/build-appsscript.mjs && node scripts/sync/appsscript-harness.mjs --file ./data/rsvps.xlsx",
    "test:sync": "node scripts/sync/selftest.mjs --file ./data/rsvps.xlsx",
    "test:partial": "node scripts/sync/verify-partial-update.mjs --file ./data/rsvps.xlsx",
    "email:pack": "node --env-file-if-exists=.env scripts/email/send-confirmations.mjs",
    "email:preview": "node scripts/email/preview.mjs",
    "email:backdrop": "node scripts/email/generate-backdrop.mjs",
    "email:assets": "node scripts/email/check-assets.mjs",
    "email:optimize": "node scripts/email/optimize-artwork.mjs",
    "email:shrink": "node scripts/email/shrink-artwork.mjs",
    "email:doctor": "node scripts/email/doctor.mjs",
    "email:audit": "node --env-file-if-exists=.env scripts/email/audit.mjs",
    "email:custom": "node --env-file-if-exists=.env scripts/email/send-custom.mjs",
    "test:email": "node scripts/email/selftest.mjs",
    "pdf:guides": "node scripts/pdf/build.mjs",
    "pdf:qr": "python3 scripts/pdf/make-qr.py",
    "pdf:verify": "node scripts/pdf/verify.mjs",
    "email:reconcile": "node --env-file-if-exists=.env scripts/email/reconcile.mjs",
    "pdf:retouch": "python3 scripts/pdf/retouch-moodboards.py",
    "email:update": "node --env-file-if-exists=.env scripts/email/send-update.mjs",
    "test:renumber": "node scripts/seating/renumber-test.mjs",
    "test:seating-ui": "node scripts/seating/ui-test.mjs",
    "test:vercel-build": "node scripts/seating/vercel-build-test.mjs",
    "email:final-details": "node --env-file-if-exists=.env scripts/email/prepare-final-details.mjs",
    "test:email:final-details": "node scripts/email/selftest-final-details.mjs",
    "email:final-details:check": "node scripts/email/selftest-final-details.mjs && node scripts/email/prepare-final-details.mjs",
    "email:final-details:audit": "node --env-file-if-exists=.env scripts/email/prepare-final-details.mjs --audit",
    "email:final-details:test": "node --env-file-if-exists=.env scripts/email/prepare-final-details.mjs --send --to",
    "email:final-details:send": "node --env-file-if-exists=.env scripts/email/prepare-final-details.mjs --send --confirm-send-all",
    "email:final-details:reconcile": "node --env-file-if-exists=.env scripts/email/reconcile-seating.mjs",
    "test:email:reconcile": "node scripts/email/selftest-reconcile.mjs",
    "test:email:name-match": "node scripts/email/selftest-name-match.mjs",
    "email:final-details:union": "node --env-file-if-exists=.env scripts/email/union-audience.mjs",
    "test:email:union": "node scripts/email/selftest-union.mjs",
    "test:email:send-auth": "node scripts/email/selftest-send-auth.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.110.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vercel/build-utils": "^14.10.1",
    "@vercel/node": "^13.0.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "exceljs": "^4.4.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19"
  }
}
