# ── Supabase ────────────────────────────────────────────────────────────────
# Website (build-time, safe to expose — RLS applies)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sync script (server-side only — NEVER commit, never expose to the browser)
# Dashboard → Project Settings → API → service_role.
# Required: the anon key cannot update rows under RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Confirmation pack (Resend) ──────────────────────────────────────────────
# resend.com → API Keys. Server-side only, never expose to the browser.
RESEND_API_KEY=re_your_api_key

# The live site. Also where the four artwork files are served from
# (<site>/email/joining.png etc.) unless INVITE_ASSET_BASE_URL overrides it.
INVITE_SITE_URL=https://your-wedding-site.com
# Optional — host the four artwork files somewhere other than the site.
# INVITE_ASSET_BASE_URL=https://cdn.example.com/wedding

# Optional. The FROM domain must be verified in Resend (Domains → Add Domain,
# then the DNS records) or every send is rejected.
# INVITE_FROM=Princess & IniOluwa <hello@princessandini.com>
# INVITE_REPLY_TO=hello@princessandini.com

# ── Google Sheets (Phase 3 — not yet enabled) ───────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_RANGE=A:Z
