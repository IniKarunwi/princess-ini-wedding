# ── Supabase ────────────────────────────────────────────────────────────────
# Website (build-time, safe to expose — RLS applies)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sync script (server-side only — NEVER commit, never expose to the browser)
# Dashboard → Project Settings → API → service_role.
# Required: the anon key cannot update rows under RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Confirmation pack (Resend) ──────────────────────────────────────────────
# resend.com → API Keys. Server-side only, never expose to the browser, and
# never paste it into a chat or an issue — rotate it if you do.
RESEND_API_KEY=re_your_api_key

# The live, DEPLOYED site. Also where the artwork is served from
# (<site>/email/joining.jpg and so on). Images in an email are fetched by URL,
# so if this is not deployed the email arrives with no pictures.
INVITE_SITE_URL=https://your-wedding-site.com

# The FROM domain must be VERIFIED in Resend (Domains → Add Domain → DNS
# records) or every send is rejected outright. Set this if your verified
# domain is not princessandini.com.
# INVITE_FROM=Princess & IniOluwa <hello@princessandini.com>

# Where guest replies land. Defaults to the From address.
# INVITE_REPLY_TO=hello@princessandini.com

# Optional — host the artwork somewhere other than the site (a CDN, Supabase
# storage). The template follows it without any other change.
# INVITE_ASSET_BASE_URL=https://cdn.example.com/wedding

# Run `npm run email:doctor` once this is filled in. It checks the key, that
# the domain is verified, and that every image actually loads over https.

# ── Seating planner API (server-side only) ──────────────────────────────────
# Used by the Vercel Functions in api/. NONE of these may be prefixed VITE_:
# Vite inlines every VITE_ variable into the browser bundle, which would
# publish the service-role key on the first deploy.
#
# Generate the two secrets with:
#   node scripts/seating/hash-pin.mjs 2530
#
# The PIN itself is never stored — only this scrypt hash of it.
PLANNER_PIN_HASH=scrypt$16384$8$1$salt$hash
# HMAC key for planner session cookies. Rotating it signs everyone out.
PLANNER_SESSION_SECRET=generate-32-random-bytes
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above are also required by the
# API, so set them for the Production and Preview environments in Vercel, not
# only in the local .env used by the sync scripts.
#
# To end every planner session at once (a rotated PIN, a lost phone), no
# deploy is needed:
#   update public.planner_settings set session_epoch = session_epoch + 1;

# ── Google Sheets (Phase 3 — not yet enabled) ───────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_RANGE=A:Z
